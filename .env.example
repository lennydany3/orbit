# Copy this file to ".env" (same folder) and paste your keys. ".env" is git-ignored, so it is never committed.
# Leave a key empty to keep using the local engine for that part.

# Language model (Groq, cloud). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Speech-to-text and text-to-speech (Sarvam AI, cloud). Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# --- Optional tuning (the defaults are fine) ---
# ORBIT_LLM=auto                       # auto = Groq if GROQ_API_KEY is set | groq | ollama (local)
# ORBIT_STT=auto                       # auto = Sarvam if SARVAM_API_KEY is set | sarvam | local (Whisper)
# ORBIT_TTS=auto                       # auto = Sarvam if SARVAM_API_KEY is set | sarvam | local (Piper)
# ORBIT_GROQ_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b (a bit faster, a bit less accurate)
# ORBIT_GROQ_REASONING=low             # low = fastest | medium | high
# ORBIT_LANGUAGE=en-IN                 # what you speak: en-IN, hi-IN, ta-IN ... or "unknown" to auto-detect
# ORBIT_SARVAM_SPEAKER=ritu           # bulbul:v3 voices: ritu, priya, neha, kavya, shubh, aditya, rahul, ...
# ORBIT_SARVAM_STT_MODEL=saarika:v2.5
# ORBIT_SARVAM_TTS_MODEL=bulbul:v3
